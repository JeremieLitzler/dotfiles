{
  "permissions": {
    "allow": [
      "Bash(bash ~/.claude/skills/save-session/scripts/save-session.sh *)",
      "mcp__codegraph__*",
      "Bash(gh pr create:*)",
      "Bash(rtk gh pr create:*)",
      "Bash(gh issue comment:*)",
      "Bash(rtk gh issue comment:*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/block-edits-on-main.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "theme": "dark-daltonized",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
